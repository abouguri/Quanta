# Groq API key — required for claim extraction and synthesis (openai/gpt-oss-120b)
# Get one at: https://console.groq.com (free tier available)
GROQ_API_KEY=

# Google Fact Check Tools API key — free, covers PolitiFact / Snopes / Reuters / AFP
# Get one at: https://developers.google.com/fact-check/tools/api/reference/rest
GOOGLE_FACT_CHECK_API_KEY=

# Brave Search API key — optional fallback for claims not in the fact-check database
# Get one at: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=

# Upstash Redis — optional, persists rate limits across server restarts
# Leave empty to use in-memory rate limiting (resets on deploy)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL — used for canonical links, OG tags, sitemap and robots.txt
# Defaults to the production deployment when unset
NEXT_PUBLIC_SITE_URL=

# Supabase — accounts (auth) and Postgres (profiles, server-side history).
# Get these from your Supabase project's Settings > API page.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security: never expose it to
# the client, never prefix it NEXT_PUBLIC_. It's used only by the Lemon
# Squeezy webhook handler to write subscription status.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy — billing (Phase 3). Get these from your Lemon Squeezy
# dashboard: Settings > API for the key, the store/product pages for the ids,
# and Settings > Webhooks for the signing secret once you've pointed a
# webhook at /api/webhooks/lemonsqueezy.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
