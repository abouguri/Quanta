# Groq API key — required for claim extraction and synthesis (llama-3.3-70b-versatile)
# Get one at: https://console.groq.com (free tier available)
# TODO: swap to ANTHROPIC_API_KEY (claude-haiku-4-5-20251001) before launch
GROQ_API_KEY=

# Google Fact Check Tools API key — free, covers PolitiFact / Snopes / Reuters / AFP
# Get one at: https://developers.google.com/fact-check/tools/api/reference/rest
GOOGLE_FACT_CHECK_API_KEY=

# Brave Search API key — optional fallback for claims not in the fact-check database
# Get one at: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=

# Upstash Redis — optional, persists rate limits across server restarts
# Leave empty to use in-memory rate limiting (resets on deploy)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
